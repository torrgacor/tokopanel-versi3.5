# MongoDB connection
MONGODB_URL=mongodb+srv://username:password@cluster0.mongodb.net/mydatabase?retryWrites=true&w=majority

# Pterodactyl API key for private/public panels
PANEL_APIKEY_PRIVATE=your_pterodactyl_api_key_here

# Payment integration (Sakuku/Pulsa/etc.)
SAKURUPIAH_APIKEY=your_sakurupiah_api_key_here
SAKURUPIAH_ID=your_sakurupiah_id_here

# Gmail SMTP app password for sending emails
GMAIL_PASSWORD=your_app_password_here

# Admin access credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_SECRET=your_admin_secret_here

# Base URL for public links and email templates
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# Reseller / public client settings
NEXT_PUBLIC_RESELLER_COMMISSION_RATE=0.15
NEXT_PUBLIC_MIN_WITHDRAWAL=50000

# Optional email sender override for reseller notifications
RESELLER_EMAIL_SENDER=noreply@yourdomain.com
